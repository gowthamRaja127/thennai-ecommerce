# ---------- Supabase (free tier: https://supabase.com) ----------
# Project Settings → API. The anon key is public (browser); the service-role key is SECRET (server only).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Razorpay (https://dashboard.razorpay.com/app/keys) ----------
# Use Test Mode keys (rzp_test_…) while developing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → POST https://<your-domain>/api/webhooks/razorpay
# Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# Set to false to hide Cash on Delivery
ENABLE_COD=true

# Production server port (npm start)
PORT=8787
